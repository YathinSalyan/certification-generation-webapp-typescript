# ============================================================================
# .env.local - Local Development Environment Variables
# Copy this file and rename to .env.local for local development
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
PORT=5000
NODE_ENV=development
IS_PROD=false

# ============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ============================================================================
# Get your connection string from: https://console.neon.tech/
# Format: postgresql://username:password@host.neon.tech/database?sslmode=require
DB_URL='postgresql://neondb_owner:npg_CNA3omyidkM5@ep-sparkling-hat-ad88oqlp-pooler.c-2.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# Example (Replace with your actual Neon URL):
# DATABASE_URL=postgresql://neondb_owner:AbCdEfGh123@ep-cool-recipe-12345.us-east-2.aws.neon.tech/certificate_generation_db?sslmode=require

# ============================================================================
# JWT SECRETS (Change these to random secure strings)
# ============================================================================
# Generate random strings using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=your-super-secret-access-token-key-minimum-32-characters-long-change-this-in-production
TRANSACTION_TOKEN_SECRET=your-super-secret-transaction-token-key-minimum-32-characters-long-change-this

# Example secure values (generate your own):
# ACCESS_TOKEN_SECRET=9f8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6
# TRANSACTION_TOKEN_SECRET=1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================
# Frontend URL for CORS and certificate validation links
FRONTEND_URL=http://localhost:3000

# For production, set to your actual frontend domain:
# FRONTEND_URL=https://your-app.vercel.app

# ============================================================================
# STORAGE CONFIGURATION - AWS S3
# ============================================================================
# Get credentials from: https://console.aws.amazon.com/iam/
S3_ACCESS_KEY_ID=your-aws-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-aws-s3-secret-access-key
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1

# Example (Replace with your actual AWS credentials):
# S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# S3_BUCKET_NAME=certificate-uploads
# S3_REGION=us-east-1

# ============================================================================
# STORAGE CONFIGURATION - Cloudinary (Alternative to S3)
# ============================================================================
# Get credentials from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Example (Replace with your actual Cloudinary credentials):
# CLOUDINARY_CLOUD_NAME=dxxxxxxxx
# CLOUDINARY_API_KEY=123456789012345
# CLOUDINARY_API_SECRET=AbCdEfGhIjKlMnOpQrStUvWxYz

# ============================================================================
# STORAGE CONFIGURATION - Local File System (Development)
# ============================================================================
# Directory for storing uploaded files locally
LOCAL_FILE_UPLOAD_DIRECTORY=./uploads

# ============================================================================
# SMS CONFIGURATION (2FA SMS) - Optional
# ============================================================================
# If you're using SMS OTP for authentication
TFA_SMS_URL=https://api.2factor.in/v2/sms
TFA_SMS_SENDER_ID=CERTFY
TFA_SMS_API_KEY=your-2fa-sms-api-key
TFA_SMS_OTP_TEMPLATE=Your OTP for certificate system is {#var#}. Valid for 5 minutes.

# Example (Replace with your actual SMS provider credentials):
# TFA_SMS_URL=https://api.twilio.com/2010-04-01/Accounts/YOUR_ACCOUNT_SID/Messages.json
# TFA_SMS_API_KEY=your_twilio_auth_token
# TFA_SMS_SENDER_ID=+1234567890

# ============================================================================
# NOTES & INSTRUCTIONS
# ============================================================================

# HOW TO GET NEON DATABASE URL:
# 1. Go to https://neon.tech/
# 2. Sign up for free account
# 3. Create a new project
# 4. Create a database named "certificate_db" (or any name you prefer)
# 5. Copy the connection string from the dashboard
# 6. Paste it in DATABASE_URL above

# HOW TO GENERATE SECURE JWT SECRETS:
# Run this command in terminal:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# REQUIRED VARIABLES (Minimum to run the app):
# - PORT
# - DATABASE_URL
# - ACCESS_TOKEN_SECRET
# - TRANSACTION_TOKEN_SECRET
# - FRONTEND_URL

# OPTIONAL VARIABLES (for full functionality):
# - S3_* (if using AWS S3 for file storage)
# - CLOUDINARY_* (if using Cloudinary for file storage)
# - LOCAL_FILE_UPLOAD_DIRECTORY (if using local storage)
# - TFA_SMS_* (if using SMS OTP authentication)

# ============================================================================
# SECURITY WARNINGS
# ============================================================================

# ⚠️ NEVER commit this file to Git!
# ⚠️ Add .env.local to .gitignore
# ⚠️ Use different secrets for production
# ⚠️ Keep JWT secrets minimum 32 characters long
# ⚠️ Never share these credentials publicly
# ⚠️ Rotate secrets periodically in production

# ============================================================================
# PRODUCTION ENVIRONMENT (.env.prod)
# ============================================================================

# For production deployment, create a separate .env.prod file with:
# - IS_PROD=true
# - Strong, unique JWT secrets (different from development)
# - Production database URL
# - Production frontend URL (HTTPS)
# - Production storage credentials